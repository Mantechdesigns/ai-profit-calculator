VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Netlify Functions - never exposed to browser)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-ghl-location-id
