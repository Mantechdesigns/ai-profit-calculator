# Client-side (Supabase uses anon key by design)
VITE_SUPABASE_URL=your-project-url
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Netlify Functions / Cloudflare Pages Functions)
# On Cloudflare: set via Dashboard > Pages > Settings > Environment Variables
# Or via CLI: wrangler pages secret put OPENAI_API_KEY
# For local dev: copy these to .dev.vars (KEY=value format, no quotes)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-ghl-location-id
